# CampusFind Backend Configuration
PORT=5001
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Staff Authentication Security Configuration (REQUIRED)
# Minimum 32 characters signing secret for HMAC-SHA256 session tokens.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_secure_random_signing_secret_at_least_32_characters_long

# Local Staff Credentials (REQUIRED)
STAFF_EMAIL=staff@campusfind.edu
STAFF_NAME=Campus Safety Officer
STAFF_ROLE=staff

# Securely salted scrypt password hash (REQUIRED)
# Generate with: node generate-password-hash.js "<your-secure-password>"
STAFF_PASSWORD_HASH=scrypt$replace_with_salt_hex$replace_with_scrypt_derived_key_hex

# Session & Cookie Configuration
TOKEN_EXPIRATION_SECONDS=3600
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
